# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# App backend (BFF)
APP_API_PORT=8000
AGENT_SERVICE_URL=http://agent:8001
PET_PIPELINE_URL=http://pet-pipeline:8002
EXPO_PUBLIC_API_URL=http://localhost:8000

# Agent providers (optional for stub mode)
AGENT_PROVIDER=stub
OPENAI_API_KEY=
ASR_PROVIDER=stub
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_TOKEN=
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
DOUBAO_ASR_TIMEOUT_SECONDS=30
TTS_PROVIDER=stub

# Pet generation providers (optional for stub mode)
PET_IMAGE_PROVIDER=stub
PET_IMAGE_MODEL=
BLENDER_EXECUTABLE=blender
ENABLE_BLENDER_JOBS=false

# Storage (local defaults; replace before production)
DATABASE_URL=sqlite:///./shengsheng.db
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=

# Safety / privacy
STORE_RAW_AUDIO=false
CHILD_DATA_RETENTION_DAYS=30
