{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shengsheng.example/schemas/agent-turn.schema.json",
  "title": "AgentTurnRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "child_id", "transcript", "learner_profile"],
  "properties": {
    "session_id": { "type": "string", "minLength": 1 },
    "child_id": { "type": "string", "minLength": 1 },
    "transcript": { "type": "string", "maxLength": 1000 },
    "learner_profile": {
      "type": "object",
      "required": ["level", "confidence", "target_sentence_words"],
      "properties": {
        "grade": { "type": "integer", "minimum": 1, "maximum": 6, "default": 1 },
        "level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "target_sentence_words": { "type": "integer", "minimum": 1, "maximum": 20 },
        "interests": { "type": "array", "items": { "type": "string" } },
        "recent_topics": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
