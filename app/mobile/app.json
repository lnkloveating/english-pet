{
  "expo": {
    "name": "声生岛",
    "slug": "shengsheng-island",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.shengshengisland"
    },
    "android": {
      "package": "com.example.shengshengisland"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "允许声生岛听见孩子说英语，以便 Momo 作出回应。",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ]
  }
}
